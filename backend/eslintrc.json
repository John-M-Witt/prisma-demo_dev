{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "ignorePatterns": ["node_modules/", "dist/"],
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "always", {"null": "ignore"}], 
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}
